{
  "defaultModel": "gpt-image-2",
  "outputDir": "output/imagegen",
  "requestTimeoutMs": 300000,
  "maxAttempts": 3,
  "maxImageBytes": 52428800,
  "maxResponseBytes": 125829120,
  "inlinePreviewLimit": 4,
  "models": {
    "gateway-flux": {
      "adapter": "openai-images",
      "model": "flux.1-dev",
      "description": "Flux model exposed by the active Pi provider's /v1/images endpoint.",
      "capabilities": {
        "generate": true,
        "edit": false,
        "references": false,
        "mask": false,
        "transparency": false,
        "inputFidelity": false,
        "maxInputImages": 0,
        "maxOutputsPerRequest": 4
      }
    }
  }
}
